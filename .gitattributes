# نرمال‌سازی پایان خط‌ها (برای کار در ویندوز و لینوکس)
* text=auto

# اسکریپت‌ها و فایل‌های متنی برنامه باید LF باشند (اسکریپت CI روی لینوکس اجرا می‌شود)
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.properties text eol=lf

# فایل‌های باینری
*.mp3 binary
*.png binary
*.jpg binary
*.apk binary
*.aab binary
*.jar binary
